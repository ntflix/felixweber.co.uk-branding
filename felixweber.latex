%%
%% felixweber.latex
%% Pandoc LaTeX template — felixweber.co.uk brand
%% Retro-pixel / lofi-digital / neon aesthetic
%% Designed for: pdflatex / xelatex / lualatex
%%
%% Usage:
%%   pandoc document.md --template=felixweber-template.latex -o output.pdf
%%   pandoc document.md --template=felixweber-template.latex --pdf-engine=xelatex -o output.pdf
%%
\documentclass[12pt, a4paper]{article}

%% ─── ENGINE DETECTION ─────────────────────────────────────────────────────────
\usepackage{iftex}

%% ─── GEOMETRY & PAGE ──────────────────────────────────────────────────────────
\usepackage[
	a4paper,
	top=28mm,
	bottom=28mm,
	left=24mm,
	right=24mm,
	headheight=14pt,
	headsep=14pt,
	footskip=18mm
]{geometry}

\usepackage{pdflscape}
\newcommand{\blandscape}{\begin{landscape}}
		\newcommand{\elandscape}{\end{landscape}}
\newcommand{\passthrough}[1]{#1}

%% ─── FONTS ────────────────────────────────────────────────────────────────────
%% XeLaTeX / LuaLaTeX: load TTF/OTF fonts directly from the system or ./fonts/
%% pdfLaTeX: falls back to clean Helvetica-style sans-serif + monospace.

\usepackage{fontspec}
\usepackage{unicode-math}
\setmathfont{Noto Sans Math}
%% PixChicago — display/headings
%% w95fa     — body text
\newfontfamily\pixchicago{pix Chicago}
\setmainfont{W95FA}[
	RawFeature={-tlig;-trep},
	FallbackFonts={
			{Noto Sans},
			{Noto Sans Symbols},
			{Noto Sans Symbols 2},
		}
]

\setmonofont{IBM Plex Mono}

%% ─── UNICODE CHARACTER FALLBACKS ─────────────────────────────────────────────
%% FallbackFonts is unreliable on macOS XeLaTeX/AAT.
%% newunicodechar maps specific missing codepoints to a fallback font directly.
\usepackage{newunicodechar}
\newfontface{\FWFallback}{Noto Sans}[Scale=0.9, RawFeature={-tlig;-trep}]
\newunicodechar{µ}{{\FWFallback µ}}
\newunicodechar{≤}{{\FWFallback ≤}}
\newunicodechar{≥}{{\FWFallback ≥}}
\newunicodechar{→}{{\FWFallback →}}
\newunicodechar{←}{{\FWFallback ←}}
\newunicodechar{×}{{\FWFallback ×}}
\newunicodechar{÷}{{\FWFallback ÷}}
\newunicodechar{°}{{\FWFallback °}}
\newunicodechar{±}{{\FWFallback ±}}
\newunicodechar{≠}{{\FWFallback ≠}}
\newunicodechar{∞}{{\FWFallback ∞}}
\newunicodechar{·}{{\FWFallback ·}}

\newunicodechar{–}{-}
\newunicodechar{—}{-}

%% ─── COLOUR ───────────────────────────────────────────────────────────────────
\usepackage[dvipsnames, svgnames, x11names]{xcolor}

%% Brand colours
\definecolor{FWPageBg}         {HTML}{FAF0FA}   %% lavender-white page background
\definecolor{FWTitlePageBg}    {HTML}{F0FAFA}   %% soft baby-blue-white
\definecolor{FWChapterPageBg}  {HTML}{F0FAFA}   %% soft lavender-white
\definecolor{FWSurface}        {HTML}{F6F6F6}   %% card/section surface - neutral off-white
\definecolor{FWText}           {HTML}{333333}   %% primary body text
\definecolor{FWNeonMagenta}    {HTML}{FB08FF}   %% neon magenta accent (full opacity)
\definecolor{FWNeonCyan}       {HTML}{08DAFF}   %% neon cyan accent   (full opacity)
\definecolor{FWMagenta64}      {cmyk}{0,0.97,0,0.02}  %% ≈ rgba(251,8,255,0.64) on white
\definecolor{FWCyan64}         {HTML}{52E8FF}   %% ≈ rgba(8,218,255,0.64) on white
\definecolor{FWDivider}        {HTML}{CCCCCC}   %% dotted HR rule
\definecolor{FWBorder}         {HTML}{D3D3D3}   %% light grey border
\definecolor{FWLavender}       {HTML}{E4ADFF}   %% readability accent (lavender)
\definecolor{FWDeepPurple}     {HTML}{4B1082}   %% deep purple for rule accents

%% ─── MICRO-TYPOGRAPHY ─────────────────────────────────────────────────────────
\usepackage{microtype}
\ifpdftex
	\usepackage[T1]{fontenc}
	\usepackage[utf8]{inputenc}
\fi

%% ─── LINE SPACING ─────────────────────────────────────────────────────────────
%% Brand spec: body line-spacing 1.2
\usepackage{setspace}
\setstretch{1.2}

%% ─── PARAGRAPHS ───────────────────────────────────────────────────────────────
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.65\baselineskip}

%% ─── CHAPTERS (Dedicated Title Pages) ─────────────────────────────────────────
\usepackage{xparse}

\makeatletter
%% 1. Ensure chapter counter exists so article class doesn't crash if Pandoc uses it
\@ifundefined{c@chapter}{\newcounter{chapter}}{}

%% 2. Force start on odd page (right-hand side of a printed booklet)
\newcommand{\cleartooddpage}{%
	\clearpage
	\ifodd\c@page\else
		\hbox{}\newpage %% Normal page style for the blank left-side page
	\fi
}

%% 3. The \chapter command override
%% s = star (\chapter*), o = optional short title, m = main title
\DeclareDocumentCommand{\chapter}{s o m}{%
	\cleartooddpage
	%% Apply title page margins (16mm)
	\newgeometry{top=16mm, bottom=16mm, left=16mm, right=16mm}%
	\thispagestyle{empty}% Keep LaTeX's default footer turned off here

	\begin{tikzpicture}[remember picture, overlay]
		%% Draw the blue background
		\fill[FWChapterPageBg]  (current page.south west) rectangle (current page.north east);

		%% Draw the page number manually in the bottom center, matching standard footer height
		%% 16mm is the footskip from the standard geometry
		\node[anchor=south, yshift=8.5mm]
		at (current page.south)
		{\pixchicago\fontsize{8}{10}\selectfont\color{FWText!50}\thepage};
	\end{tikzpicture}%
	%
	%% Add to TOC
	\IfBooleanF{#1}{%
		\refstepcounter{chapter}%
		\addcontentsline{toc}{chapter}{#3}%
	}%

	\vspace*{10mm}%  %% Spacing from top margin
	\noindent

	%% Chapter Number (Only prints if not a starred \chapter*)
	\IfBooleanF{#1}{%
		{\pixchicago\fontsize{14}{18}\selectfont\color{FWNeonMagenta}CHAPTER \thechapter\par}%
		\vspace{4mm}%
	}%

	%% Chapter Title
	{\pixchicago\fontsize{34}{40}\selectfont
		\fwshadowhead{FWNeonCyan}{-1.5pt}{-1pt}{#3}\par}%

	%% Restore main body margins (24mm/28mm) for the next page
	\restoregeometry
	\clearpage
}
\makeatother

%% ─── SECTION HEADINGS ─────────────────────────────────────────────────────────
\usepackage{titlesec}

%% H1 — magenta shadow, left-aligned
\titleformat{\section}[block]
{\pixchicago\fontsize{20}{24}\selectfont\raggedright}
{}{0pt}
{\fwshadowhead{FWNeonMagenta}{-1.5pt}{-1pt}}

%% H2 — cyan shadow, left-aligned
\titleformat{\subsection}[block]
{\pixchicago\fontsize{15}{18}\selectfont\raggedright}
{}{0pt}
{\fwshadowhead{FWNeonCyan}{-1.2pt}{-0.8pt}}

%% H3 — no shadow
\titleformat{\subsubsection}[block]
{\pixchicago\fontsize{11}{13}\selectfont\color{FWText}\raggedright}
{}{0pt}{}[]

%% H4
\titleformat{\paragraph}[runin]
{\pixchicago\fontsize{11}{13}\selectfont\color{FWText}\bfseries}
{}{0pt}{}[\hspace{0.5em}]

%% H5 / H6
\titleformat{\subparagraph}[runin]
{\pixchicago\fontsize{10}{12}\selectfont\color{FWText}\bfseries}
{}{0pt}{}[\hspace{0.5em}]

%% Heading spacing (brand: margin 10px, padding-bottom 15px)
\titlespacing*{\section}         {0pt}{10pt}{10pt}
\titlespacing*{\subsection}      {0pt}{10pt}{10pt}
\titlespacing*{\subsubsection}   {0pt}{10pt plus 2pt minus 2pt}{4pt}
\titlespacing*{\paragraph}       {0pt}{8pt plus 2pt minus 2pt}{1em}
\titlespacing*{\subparagraph}    {0pt}{6pt plus 1pt minus 1pt}{1em}

%% ─── TIKZ (used for decorative elements) ─────────────────────────────────────
\usepackage{tikz}
\usetikzlibrary{positioning, calc}

%% ─── HEADER & FOOTER ──────────────────────────────────────────────────────────
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}

\fancyfoot[C]{%
	\leavevmode%
	{\pixchicago\fontsize{8}{10}\selectfont\color{FWText!50}%
		\thepage}%
}

\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

%% ─── SHADOW HEADING HELPER ────────────────────────────────────────────────────
%% \fwshadowhead{shadow-colour}{hshift}{vshift}{text}
%% Renders text with a single-colour pixel-offset shadow layer beneath FWText.
\newcommand{\fwshadowhead}[4]{%
	\leavevmode
	\rlap{\raisebox{#3}[0pt][0pt]{%
			\hspace*{#2}%
			\parbox[t]{\linewidth}{\raggedright\color{#1}#4}%
		}}%
	\parbox[t]{\linewidth}{\raggedright\color{FWText}#4}%
}

%% ─── HORIZONTAL RULE — square dotted line for Pandoc thematic breaks ────────
\makeatletter
\renewcommand{\hrulefill}{%
	\par\vspace{1.5em}%                    %% Vertical space above
	\noindent
	\makebox[\linewidth][c]{%              %% Centre the rule on the page
		\hbox to 0.5\linewidth{%           %% Restrict width to 50% (ample margins)
			\color{FWText}%
			\xleaders\hbox{%
				\raisebox{0.2ex}{\vrule width 1.2pt height 1.2pt depth 0pt}%
				\hspace{3pt}%
			}\hfill
			\kern0pt
		}%
	}%
	\par\vspace{1.5em}%                    %% Vertical space below
}
\makeatother

%% ─── LISTS ────────────────────────────────────────────────────────────────────
\usepackage{enumitem}
\setlist[itemize]{
	leftmargin=1.4em,
	itemsep=0.2\baselineskip,
	parsep=0pt,
	label={\pixchicago\fontsize{8}{10}\selectfont\color{FWText!60}>}
}
\setlist[enumerate]{
	leftmargin=1.6em,
	itemsep=0.2\baselineskip,
	parsep=0pt,
	label={\pixchicago\fontsize{9}{11}\selectfont\color{FWText!60}\arabic*.}
}

%% ─── TABLES ───────────────────────────────────────────────────────────────────
\usepackage{longtable, booktabs, array, tabularx}
%% Pandoc 3.8+ sets \LTcaptype to suppress table numbering.
%% Older longtable (<4.21 / TeX Live <2024) does not support this.
%% Define a dummy 'none' counter as a fallback.
\usepackage{arydshln}
%% Pandoc 3.8+ sets \LTcaptype to suppress table numbering.
\makeatletter
\@ifundefined{c@none}{\newcounter{none}}{}
\makeatother

\usepackage{colortbl}

%% Brand table style: light surface rows, neon cyan top rule, dotted separator
\renewcommand{\toprule}{\arrayrulecolor{FWNeonMagenta}\hline\arrayrulecolor{FWDivider}}
\renewcommand{\bottomrule}{\arrayrulecolor{FWNeonCyan}\hline}
\renewcommand{\midrule}{\arrayrulecolor{FWDivider}\hdashline[1pt/2pt]}
\renewcommand{\arraystretch}{1.35}

%% Shaded header row helper: wrap thead cells with \theadcell{text}
\newcommand{\theadcell}[1]{%
	\cellcolor{FWSurface}\pixchicago\fontsize{9}{11}\selectfont\color{FWText}#1%
}

%% ─── CODE BLOCKS ──────────────────────────────────────────────────────────────
\usepackage{listings}

%% Code font: monospace, dark surface card, neon cyan frame
\lstset{
	basicstyle=\ttfamily\fontsize{8}{10}\selectfont\color{FWText},
	backgroundcolor=\color{FWSurface},
	frame=single,
	framesep=6pt,
	rulecolor=\color{FWNeonCyan},
	xleftmargin=10pt, xrightmargin=10pt,
	aboveskip=12pt, belowskip=12pt,
	breaklines=true,
	breakatwhitespace=true,
	showstringspaces=false,
	keywordstyle=\color{FWNeonMagenta}\bfseries,
	commentstyle=\color{FWText!50}\itshape,
	stringstyle=\color{FWNeonCyan},
	numberstyle=\ttfamily\fontsize{6}{8}\selectfont\color{FWText!40},
	numbers=left,
	numbersep=8pt,
	tabsize=2,
}

%% Shaded — wraps Pandoc verbatim blocks in a branded surface card
\newenvironment{Shaded}{\begin{pixcard}[FWText]}{\end{pixcard}}

%% ─── SKYLIGHTING TOKEN COMMANDS ─────────────────────────────────────────────
\usepackage{fancyvrb}

%% Required when Pandoc emits highlighted code via Shaded/Highlighting.
%% Colours mapped to brand palette.
\newcommand{\AlertTok}[1]{\textcolor{FWNeonMagenta}{\textbf{#1}}}
\newcommand{\AnnotationTok}[1]{\textcolor{FWText!60}{\textit{#1}}}
\newcommand{\AttributeTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\BaseNTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\BuiltInTok}[1]{\textcolor{FWNeonMagenta}{#1}}
\newcommand{\CharTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\CommentTok}[1]{\textcolor{FWText!50}{\textit{#1}}}
\newcommand{\CommentVarTok}[1]{\textcolor{FWText!50}{\textit{#1}}}
\newcommand{\ConstantTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\ControlFlowTok}[1]{\textcolor{FWNeonMagenta}{\textbf{#1}}}
\newcommand{\DataTypeTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\DecValTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\DocumentationTok}[1]{\textcolor{FWText!60}{\textit{#1}}}
\newcommand{\ErrorTok}[1]{\textcolor{FWNeonMagenta}{\textbf{#1}}}
\newcommand{\ExtensionTok}[1]{#1}
\newcommand{\FloatTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\FunctionTok}[1]{\textcolor{FWNeonMagenta}{#1}}
\newcommand{\ImportTok}[1]{#1}
\newcommand{\InformationTok}[1]{\textcolor{FWText!60}{\textit{#1}}}
\newcommand{\KeywordTok}[1]{\textcolor{FWNeonMagenta}{\textbf{#1}}}
\newcommand{\NormalTok}[1]{\textcolor{FWText}{#1}}
\newcommand{\OperatorTok}[1]{\textcolor{FWText}{#1}}
\newcommand{\OtherTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\PreprocessorTok}[1]{\textcolor{FWNeonMagenta}{#1}}
\newcommand{\RegionMarkerTok}[1]{#1}
\newcommand{\SpecialCharTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\SpecialStringTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\StringTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\VariableTok}[1]{\textcolor{FWText}{#1}}
\newcommand{\VerbatimStringTok}[1]{\textcolor{FWNeonCyan}{#1}}
\newcommand{\WarningTok}[1]{\textcolor{FWNeonMagenta}{\textit{#1}}}

%% Highlighting — Pandoc emits \begin{Highlighting}[] inside every Shaded block.
%% Uses fancyvrb's Verbatim so token commands (\KeywordTok etc.) render correctly.
\newenvironment{Highlighting}[1][]{%
\setlength{\topsep}{0pt}%
\setlength{\partopsep}{0pt}%
\Verbatim[commandchars=\\\{\},#1]%
}{%
\endVerbatim%
}

%% ─── BLOCKQUOTES ──────────────────────────────────────────────────────────────
\renewenvironment{quote}{\begin{pixcard}[FWText]\color{FWText!80}}{\end{pixcard}}

%% ─── HYPERLINKS ───────────────────────────────────────────────────────────────
\usepackage[
	colorlinks=true,
	linkcolor=FWNeonMagenta,
	urlcolor=FWNeonCyan,
	citecolor=FWLavender,
	filecolor=FWNeonMagenta,
	pdfborder={0 0 0},
	unicode=true,
	bookmarks=true,
	bookmarksnumbered=false,
	bookmarksopen=true,
	pdftitle={$if(title)$$title$$endif$},
	pdfauthor={$if(author)$$for(author)$$author$$sep$, $endfor$$endif$},
	pdfsubject={$if(subtitle)$$subtitle$$endif$},
	pdfkeywords={$if(keywords)$$for(keywords)$$keywords$$sep$, $endfor$$endif$},
]{hyperref}

