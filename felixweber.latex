%% Lavender-white body background (#FAF0FA) — requires eso-pic
\usepackage{eso-pic}
\AddToShipoutPictureBG{%
	\AtPageLowerLeft{%
		\color{FWPageBg}\rule{\paperwidth}{\paperheight}%
	}%
}

%% ─── DECORATIVE PIXEL-CORNER CARD ─────────────────────────────────────────────
\usepackage[skins]{tcolorbox}
\tcbuselibrary{skins}

%% Define the reusable pixel card style (acts as a 9-slice grid)
\tcbset{
	pixcardstyle/.style={
			enhanced,
			empty, %% Removes default frame and background drawing
			boxsep=0pt,
			left=14pt,        %% Replaces innerleftmargin
			right=14pt,       %% Replaces innerrightmargin
			top=12pt,         %% Replaces innertopmargin
			bottom=12pt,      %% Replaces innerbottommargin
			before skip=12pt, %% Replaces skipabove
			after skip=12pt,  %% Replaces skipbelow
			underlay={
					%% 1. Draw the stepped background
					\fill[FWSurface]
					([xshift=7.5pt]frame.north west) --
					([xshift=-7.5pt]frame.north east) --
					([yshift=-7.5pt]frame.north east) --
					([yshift=7.5pt]frame.south east) --
					([xshift=-7.5pt]frame.south east) --
					([xshift=7.5pt]frame.south west) --
					([yshift=7.5pt]frame.south west) --
					([yshift=-7.5pt]frame.north west) -- cycle;

					%% 2. Draw the 4 straight edges (1.5pt thick)
					\fill[#1] ([xshift=6pt]frame.north west) rectangle ([yshift=-1.5pt, xshift=-6pt]frame.north east); %% Top
					\fill[#1] ([xshift=6pt]frame.south west) rectangle ([yshift=1.5pt, xshift=-6pt]frame.south east);  %% Bottom
					\fill[#1] ([yshift=-6pt]frame.north west) rectangle ([yshift=6pt, xshift=1.5pt]frame.south west);  %% Left
					\fill[#1] ([yshift=-6pt]frame.north east) rectangle ([yshift=6pt, xshift=-1.5pt]frame.south east); %% Right

					%% 3. Draw the corner pixels to create the stair-step curve
					%% Top Left
					\fill[#1] ([xshift=1.5pt, yshift=-6pt]frame.north west) rectangle ([xshift=3pt, yshift=-7.5pt]frame.north west);
					\fill[#1] ([xshift=1.5pt, yshift=-4.5pt]frame.north west) rectangle ([xshift=3pt, yshift=-6pt]frame.north west);
					\fill[#1] ([xshift=1.5pt, yshift=-3pt]frame.north west) rectangle ([xshift=3pt, yshift=-4.5pt]frame.north west);
					\fill[#1] ([xshift=3pt, yshift=-3pt]frame.north west) rectangle ([xshift=4.5pt, yshift=-4.5pt]frame.north west);
					\fill[#1] ([xshift=3pt, yshift=-1.5pt]frame.north west) rectangle ([xshift=4.5pt, yshift=-3pt]frame.north west);
					\fill[#1] ([xshift=4.5pt, yshift=-1.5pt]frame.north west) rectangle ([xshift=6pt, yshift=-3pt]frame.north west);
					\fill[#1] ([xshift=6pt, yshift=-1.5pt]frame.north west) rectangle ([xshift=7.5pt, yshift=-3pt]frame.north west);

					%% Top Right
					\fill[#1] ([xshift=-3pt, yshift=-6pt]frame.north east) rectangle ([xshift=-1.5pt, yshift=-7.5pt]frame.north east);
					\fill[#1] ([xshift=-3pt, yshift=-4.5pt]frame.north east) rectangle ([xshift=-1.5pt, yshift=-6pt]frame.north east);
					\fill[#1] ([xshift=-3pt, yshift=-3pt]frame.north east) rectangle ([xshift=-1.5pt, yshift=-4.5pt]frame.north east);
					\fill[#1] ([xshift=-4.5pt, yshift=-3pt]frame.north east) rectangle ([xshift=-3pt, yshift=-4.5pt]frame.north east);
					\fill[#1] ([xshift=-4.5pt, yshift=-1.5pt]frame.north east) rectangle ([xshift=-3pt, yshift=-3pt]frame.north east);
					\fill[#1] ([xshift=-6pt, yshift=-1.5pt]frame.north east) rectangle ([xshift=-4.5pt, yshift=-3pt]frame.north east);
					\fill[#1] ([xshift=-6pt, yshift=-1.5pt]frame.north east) rectangle ([xshift=-7.5pt, yshift=-3pt]frame.north east);

					%% Bottom Left
					\fill[#1] ([xshift=1.5pt, yshift=6pt]frame.south west) rectangle ([xshift=3pt, yshift=7.5pt]frame.south west);
					\fill[#1] ([xshift=1.5pt, yshift=4.5pt]frame.south west) rectangle ([xshift=3pt, yshift=6pt]frame.south west);
					\fill[#1] ([xshift=1.5pt, yshift=3pt]frame.south west) rectangle ([xshift=3pt, yshift=4.5pt]frame.south west);
					\fill[#1] ([xshift=3pt, yshift=3pt]frame.south west) rectangle ([xshift=4.5pt, yshift=4.5pt]frame.south west);
					\fill[#1] ([xshift=3pt, yshift=1.5pt]frame.south west) rectangle ([xshift=4.5pt, yshift=3pt]frame.south west);
					\fill[#1] ([xshift=4.5pt, yshift=1.5pt]frame.south west) rectangle ([xshift=6pt, yshift=3pt]frame.south west);
					\fill[#1] ([xshift=6pt, yshift=1.5pt]frame.south west) rectangle ([xshift=7.5pt, yshift=3pt]frame.south west);

					%% Bottom Right
					\fill[#1] ([xshift=-3pt, yshift=6pt]frame.south east) rectangle ([xshift=-1.5pt, yshift=7.5pt]frame.south east);
					\fill[#1] ([xshift=-3pt, yshift=4.5pt]frame.south east) rectangle ([xshift=-1.5pt, yshift=6pt]frame.south east);
					\fill[#1] ([xshift=-3pt, yshift=3pt]frame.south east) rectangle ([xshift=-1.5pt, yshift=4.5pt]frame.south east);
					\fill[#1] ([xshift=-4.5pt, yshift=3pt]frame.south east) rectangle ([xshift=-3pt, yshift=4.5pt]frame.south east);
					\fill[#1] ([xshift=-4.5pt, yshift=1.5pt]frame.south east) rectangle ([xshift=-3pt, yshift=3pt]frame.south east);
					\fill[#1] ([xshift=-6pt, yshift=1.5pt]frame.south east) rectangle ([xshift=-4.5pt, yshift=3pt]frame.south east);
					\fill[#1] ([xshift=-6pt, yshift=1.5pt]frame.south east) rectangle ([xshift=-7.5pt, yshift=3pt]frame.south east);
				}
		}
}

%% Provide the environment. Usage: \begin{pixcard}[BorderColour]
\newtcolorbox{pixcard}[1][FWText]{pixcardstyle=#1}

%% ─── TITLE PAGE ───────────────────────────────────────────────────────────────
\makeatletter

\renewcommand{\maketitle}{%
	\thispagestyle{empty}%
	\newgeometry{top=16mm, bottom=16mm, left=16mm, right=16mm}%
	\begin{tikzpicture}[remember picture, overlay]
		\fill[FWTitlePageBg] (current page.south west) rectangle (current page.north east);
	\end{tikzpicture}%
	%
	%% Fill the entire text height, centred vertically
	\noindent\begin{minipage}[c][\textheight][c]{\textwidth}
		%% Document title — Top-aligned Overlapping Minipages
		{\pixchicago\fontsize{34}{40}\selectfont
			\fwshadowhead{FWNeonMagenta}{-1.5pt}{-1pt}{\@title}\par}
		\vspace{10mm}%

		%% Subtitle
		$if(subtitle)$%
		{\pixchicago\fontsize{14}{17}\selectfont\color{FWText!70}$subtitle$\par}%
		\vspace{8mm}%
		$endif$%
		%% Author(s)
		$if(author)$%
		{\pixchicago\fontsize{12}{15}\selectfont\color{FWText}%
				$for(author)$$author$$sep$ \\ $endfor$\par}%
		\vspace{6mm}%
		$endif$%
		%% Date
		$if(date)$%
		{\fontsize{10}{12}\selectfont\color{FWText!60}$date$\par}%
		$endif$%
	\end{minipage}%
	%
	\begin{tikzpicture}[remember picture, overlay]
		\node[anchor=south west, xshift=16mm, yshift=16mm,
			text=FWNeonCyan]
		at (current page.south west)
		{\pixchicago\fontsize{7.5}{9}\selectfont felixweber.co.uk};
	\end{tikzpicture}%
	\restoregeometry%
	\clearpage%
}

\makeatother

%% ─── ABSTRACT ─────────────────────────────────────────────────────────────────
$if(abstract)$
\renewenvironment{abstract}{%
	\begin{pixcard}%
		{\pixchicago\fontsize{9}{11}\selectfont\color{FWNeonMagenta}ABSTRACT\par}%
		\vspace{4pt}%
		}{%
	\end{pixcard}%
	\vspace{8pt}%
	\cleartooddpage%
}
$endif$

%% ─── TABLE OF CONTENTS ────────────────────────────────────────────────────────
$if(toc)$
\usepackage{titletoc}
\contentsmargin{0pt}
\titlecontents{part}[0pt]
{
	\vspace{6pt}
	\pixchicago
	\fontsize{16}{20}
	\selectfont
	\color{FWNeonMagenta}}
{}{}
{\hfill
	\pixchicago
	\fontsize{9}{11}
	\selectfont
	\color{FWText!60}
	\contentspage}

\titlecontents{chapter}[0pt]
{
	\vspace{6pt}
	\pixchicago
	\fontsize{16}{20}
	\selectfont
	\color{FWNeonMagenta}}
{}{}
{\hfill
	\pixchicago
	\fontsize{9}{11}
	\selectfont
	\color{FWText!60}
	\contentspage}

\titlecontents{section}[0pt]
{
	\vspace{4pt}
	\pixchicago
	\fontsize{10}{12}
	\selectfont
	\color{FWText}}
{}{}
{\hfill
	\pixchicago
	\fontsize{9}{11}
	\selectfont
	\color{FWText!60}
	\contentspage}

\titlecontents{subsection}[1.2em]
{
	\vspace{2pt}
	\fontsize{10}{11}
	\selectfont
	\color{FWText!80}}
{}{}
{\hfill
	\fontsize{9}{10}
	\selectfont
	\color{FWText!60}
	\contentspage}

\titlecontents{subsubsection}[2.6em]
{
	\vspace{1pt}
	\fontsize{10}{11}
	\selectfont
	\color{FWText!80}}
{}{}
{\hfill
	\fontsize{9}{10}
	\selectfont
	\color{FWText!60}
	\contentspage}

$endif$

%% ─── DOCUMENT BEGIN ───────────────────────────────────────────────────────────
$if(title)$
\title{$title$}
$if(author)$\author{$for(author)$$author$$sep$ \and $endfor$}$endif$
$if(date)$\date{$date$}$else$\date{}$endif$
$endif$

\begin{document}

$if(title)$
\maketitle
$endif$

$if(abstract)$
\begin{abstract}
	$abstract$
\end{abstract}
$endif$

$if(toc)$
{%
		\hypersetup{linkcolor=FWText}
		\setcounter{tocdepth}{$toc-depth$}
		\tableofcontents
		\clearpage
	}
$endif$

$body$

$if(natbib)$
$if(bibliography)$
$if(biblio-title)$
$if(has-chapters)$
\renewcommand\bibname{$biblio-title$}
$else$
\renewcommand\refname{$biblio-title$}
$endif$
$endif$
\bibliography{$for(bibliography)$$bibliography$$sep$,$endfor$}
$endif$
$endif$

$if(biblatex)$
\printbibliography$if(biblio-title)$[title=$biblio-title$]$endif$
$endif$

$if(nocite-ids)$
\nocite{$for(nocite-ids)$$it$$sep$,$endfor$}
$endif$

\end{document}
